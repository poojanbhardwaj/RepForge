# Local development only. `pnpm run setup` writes generated values to .env.local.
APP_ENV=local
AUTH_MODE=dev
HTTP_ADDRESS=127.0.0.1:8080
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s
READINESS_TIMEOUT=2s
WORKER_IDLE_ALLOWED=true

DEV_AUTH_TOKEN=__GENERATED_DEV_AUTH_TOKEN__
DEV_AUTH_SUBJECT=local-user
DEV_AUTH_PROVIDER=repforge-dev

# OIDC application paths. Switch AUTH_MODE to oidc only after filling both client IDs.
OIDC_ISSUER=https://repforge-dev-poojan.jp.auth0.com/
OIDC_AUDIENCE=https://api.dev.repforge.invalid
OIDC_MOBILE_CLIENT_ID=__POPULATE_AUTH0_MOBILE_CLIENT_ID__
OIDC_WEB_CLIENT_ID=__POPULATE_AUTH0_WEB_CLIENT_ID__
CORS_ALLOWED_ORIGIN=http://127.0.0.1:3000
TERMS_VERSION=draft-local-1
PRIVACY_VERSION=draft-local-1

POSTGRES_USER=repforge
POSTGRES_PASSWORD=__GENERATED_POSTGRES_PASSWORD__
POSTGRES_DB=repforge
POSTGRES_PORT=5432
DATABASE_URL=postgres://repforge:__GENERATED_POSTGRES_PASSWORD__@127.0.0.1:5432/repforge?sslmode=disable

REDIS_PASSWORD=__GENERATED_REDIS_PASSWORD__
REDIS_PORT=6379
REDIS_URL=redis://:__GENERATED_REDIS_PASSWORD__@127.0.0.1:6379/0

GARAGE_S3_PORT=3900
GARAGE_ADMIN_PORT=3903
GARAGE_ACCESS_KEY=__GENERATED_GARAGE_ACCESS_KEY__
GARAGE_SECRET_KEY=__GENERATED_GARAGE_SECRET_KEY__
GARAGE_BUCKET=repforge-local
S3_ENDPOINT=http://127.0.0.1:3900
S3_REGION=garage
S3_FORCE_PATH_STYLE=true

EXPO_PUBLIC_API_URL=http://127.0.0.1:8080
EXPO_PUBLIC_AUTH_MODE=dev
EXPO_PUBLIC_DEV_AUTH_TOKEN=__GENERATED_DEV_AUTH_TOKEN__
EXPO_PUBLIC_AUTH0_DOMAIN=repforge-dev-poojan.jp.auth0.com
EXPO_PUBLIC_AUTH0_CLIENT_ID=__POPULATE_AUTH0_MOBILE_CLIENT_ID__
EXPO_PUBLIC_AUTH0_AUDIENCE=https://api.dev.repforge.invalid

# Next.js Auth0 BFF configuration. The client secret must be supplied manually and kept local.
AUTH0_DOMAIN=repforge-dev-poojan.jp.auth0.com
AUTH0_CLIENT_ID=__POPULATE_AUTH0_WEB_CLIENT_ID__
AUTH0_CLIENT_SECRET=__POPULATE_AUTH0_WEB_CLIENT_SECRET__
AUTH0_SECRET=__GENERATED_AUTH0_COOKIE_SECRET__
APP_BASE_URL=http://127.0.0.1:3000
AUTH0_AUDIENCE=https://api.dev.repforge.invalid
API_BASE_URL=http://127.0.0.1:8080
