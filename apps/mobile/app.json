{
  "expo": {
    "name": "RepForge",
    "slug": "repforge",
    "version": "0.0.1",
    "orientation": "portrait",
    "scheme": "repforge",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      ["expo-dev-client", { "launchMode": "most-recent" }],
      [
        "react-native-auth0",
        {
          "domain": "repforge-dev-poojan.jp.auth0.com",
          "customScheme": "repforge"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "autolinkingModuleResolution": true
    },
    "android": {
      "package": "local.repforge.bootstrap"
    },
    "ios": {
      "bundleIdentifier": "local.repforge.bootstrap",
      "supportsTablet": true
    }
  }
}
